# Hetzner Cloud API token. hetzner-k3s reads this from the environment only -
# hetzner/cluster_config.yaml deliberately carries no hetzner_token key, since
# YAML has no interpolation and the literal string would override the env var.
HCLOUD_TOKEN=

# Infisical Machine Identity (Universal Auth, eu.infisical.com). Root of trust
# for every secret in the cluster; the CLI prompts if these are unset.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
